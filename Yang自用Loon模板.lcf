[Rule]

# Local Rule
# Type:DOMAIN-SUFFIX,DOMAIN,DOMAIN-KEYWORD,USER-AGENT,URL-REGEX,IP-CIDR,IP-CIDR6,IP-ASN
# Strategy:DIRECT,Proxy,REJECT
# Options:no-resolve(no-resolve(only for cidr))
# IP-CIDR,192.168.0.0/16,DIRECT
# IP-CIDR,10.0.0.0/8,DIRECT
# IP-CIDR,172.16.0.0/12,DIRECT
# IP-CIDR,127.0.0.0/8,DIRECT
# 当配置文件中没有任何有效策略组时，Loon将使用内置的PROXY策略组
# 当配置文件中存在有效的策略组时，内置的PROXY策略组将不再允许被调用，仅可使用用户配置的策略组

# 请勿修改远程CN REGION规则的排序甚至删除
DOMAIN-SUFFIX,apple-relay.apple.com,💬 OpenAi
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,💬 OpenAi
DOMAIN-SUFFIX,apple-relay.cloudflare.com,💬 OpenAi
DOMAIN-SUFFIX,gateway.icloud.com,💬 OpenAi
DOMAIN-SUFFIX,guzzoni.apple.com,💬 OpenAi
DOMAIN-SUFFIX,cp4.cloudflare.com,💬 OpenAi
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com,💬 OpenAi
DOMAIN-SUFFIX,apps.mzstatic.com,💬 OpenAi
URL-REGEX,"^pic\.\d+\.xyx$",📲 Telegram
DOMAIN-SUFFIX,ip.sb,direct
DOMAIN,dnsdblookup.com,proxy
#以下为小程序公众号去广告
DOMAIN,wxa.wxs.qq.com,REJECT
DOMAIN,wximg.wxs.qq.com,REJECT
DOMAIN,wxsmw.wxs.qq.com,REJECT
#以上
DOMAIN-SUFFIX,img.ithome.com,DIRECT
IP-ASN,45102,DIRECT
IP-CIDR,10.0.0.0/8,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT
IP-CIDR,172.16.0.0/12,DIRECT
IP-CIDR,192.168.0.0/16,DIRECT
IP-CIDR,192.168.0.1/24,DIRECT
IP-CIDR,192.168.1.1/24,DIRECT
IP-CIDR,224.0.0.0/24,DIRECT
#IP-CIDR6,::/0,DIRECT
GEOIP,cn,DIRECT
FINAL,🚀 节点选择
 



